# Set these in your local .env file and in Netlify site environment variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional HTTPS endpoint for a server-side AI interpretation function.
# Never put an OpenAI or other private API key in a VITE_ variable.
VITE_ASK_BYZANTIUM_AI_ENDPOINT=
